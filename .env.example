# ==============================================================================
# API Investigator - Environment Configuration Template
# Copy this file to .env and configure the values for your environment.
# DO NOT commit real credentials or production secrets to source control.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME="API Investigator"
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key
DEBUG=true
LOG_LEVEL=INFO

# Network & Server Settings
PORT=8000
HOST=0.0.0.0
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Primary: PostgreSQL 16
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/api_investigator
# SQLite fallback (uncomment for local zero-dependency testing):
# DATABASE_URL=sqlite+aiosqlite:///./api_investigator.db

# Cache & Background Queue
REDIS_URL=redis://localhost:6379/0

# Security & Sensitive Data Encryption
# Secret key for hashing ingestion API keys (HMAC-SHA256)
INGESTION_KEY_HASH_SECRET=replace-with-a-secure-random-hash-secret
# 32-byte Base64 encryption key for monitor headers & credentials at rest
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# AI Investigation Provider
# Supported: "mock" (offline deterministic demo), "gemini", "openai", "anthropic"
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

# Notification & Webhook Integrations
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM=alerts@api-investigator.dev

# Frontend Public Settings (Read by apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# Demo & Fixture Mode
DEMO_MODE=true
