# ==============================================================================
# API Investigator - Environment Configuration Template
# Copy this file to .env and configure the values for your environment.
# DO NOT commit real credentials or production secrets to source control.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME="API Investigator"
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key
DEBUG=true
LOG_LEVEL=INFO

# Network & Server Settings
PORT=8000
HOST=0.0.0.0
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Primary: PostgreSQL 16
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/api_investigator
# SQLite fallback (uncomment for local zero-dependency testing):
# DATABASE_URL=sqlite+aiosqlite:///./api_investigator.db

# Cache & Background Queue
REDIS_URL=redis://localhost:6379/0

# Security & Sensitive Data Encryption
# Secret key for hashing ingestion API keys (HMAC-SHA256)
INGESTION_KEY_HASH_SECRET=replace-with-a-secure-random-hash-secret
# 32-byte Base64 encryption key for monitor headers & credentials at rest
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# AI Investigation Engine Provider
# ------------------------------------------------------------------------------
# Default is "mock" (built-in offline deterministic heuristic engine with 0 API calls).
# When your Google AI Studio Gemini API limit is reached, switch to any of these alternatives:
#
# Option A: Groq (Recommended - Free & Fast)
# Get a free key at https://console.groq.com
# AI_PROVIDER=groq
# AI_API_KEY=gsk_your_groq_api_key_here
# AI_MODEL=llama-3.3-70b-versatile
#
# Option B: Ollama (100% Free, Local, No Rate Limits, No Key Needed)
# Run `ollama run llama3.2` locally, then set:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
#
# Option C: OpenRouter (Free + Cheap multi-provider catalog)
# Get a key at https://openrouter.ai
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-v1-your_openrouter_key
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Option D: OpenAI
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-openai-api-key
# AI_MODEL=gpt-4o-mini
#
# Option E: DeepSeek
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-your-deepseek-api-key
# AI_MODEL=deepseek-chat
#
# Option F: Gemini (Google AI Studio)
# AI_PROVIDER=gemini
# AI_API_KEY=AIzaSyYourGeminiApiKeyHere
# AI_MODEL=gemini-1.5-flash
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30

# Notification & Webhook Integrations
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM=alerts@api-investigator.dev

# Frontend Public Settings (Read by apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# Demo & Fixture Mode
DEMO_MODE=true
